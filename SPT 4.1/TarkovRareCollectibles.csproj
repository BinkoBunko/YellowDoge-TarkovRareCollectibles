<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TarkovRareCollectibles</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.2.2</Version>
    <!-- The two lines below will set the output path for the binaries -->
	<!-- Change to match your setup. -->
    <OutputPath>..\..\..\SPT_Runtime\user\mods\yellowdoge-tarkovrarecollectibles\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.0" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.0" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.0" />
  </ItemGroup>
	<ItemGroup>
		<Content Include="bundles\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <Content Update="bundles.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
</Project>